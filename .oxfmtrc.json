{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "internalPattern": ["@/", "@pier/"],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/styles/app.css",
    "functions": ["cn", "clsx"]
  },
  "ignorePatterns": ["bun.lock", "**/gql/**", "**/routeTree.gen.ts", "docs/**"]
}
